# Canonical public site URL (sitemap, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://expalapp.netlify.app

# Logged-in EXPal app. Join / Open app buttons go here.
NEXT_PUBLIC_APP_URL=https://expalapp.netlify.app

# Application id used in the web manifest and Android App Links.
NEXT_PUBLIC_APP_ID=com.yourbrandexpal

# Password for /admin so you can write and publish blog posts.
ADMIN_PASSWORD=change-me

# Optional extra secret for the admin session cookie. Falls back to ADMIN_PASSWORD.
ADMIN_SECRET=
