# Public site URL used in sitemap, canonical tags, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: URL of the logged-in EXPal app (Google sign-in). Leave empty to keep the landing page fully public.
NEXT_PUBLIC_APP_URL=

# Application id used in the web manifest and Android App Links.
NEXT_PUBLIC_APP_ID=com.yourbrandexpal

# Password for /admin so you can write and publish blog posts.
ADMIN_PASSWORD=change-me

# Optional extra secret for the admin session cookie. Falls back to ADMIN_PASSWORD.
ADMIN_SECRET=
